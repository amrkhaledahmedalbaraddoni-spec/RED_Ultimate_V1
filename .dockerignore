# The CI image builds from the repository root, so this file is the allow-list
# boundary for every plane.
.git
.github
**/.gradle
**/build
**/dist
**/node_modules
**/.idea
**/*.iml
**/__pycache__

# Never ship secrets or private configuration into an image.
platform/secrets
platform/config/.env
.env

# Not needed to build any artifact.
docs
tools/reproducible-builds
data/runtime
data/fixtures
data/seeds
local-artifacts
local-tools
local-maven/org/signal
