# RED Ultimate Sovereign - Environment Variables Template
# Copy to .env and fill with secure values
# Version: 2.0.0-ULTIMATE - 100% Local Sovereign

# ==================== DATABASES ====================
# PostgreSQL - Authority & Metadata
POSTGRES_DB=red_sovereign
POSTGRES_USER=red_user
DB_PASSWORD=CHANGE_ME_STRONG_POSTGRES_32_CHARS_MIN
POSTGRES_PASSWORD=${DB_PASSWORD}
MONGO_ROOT_USER=red_root
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_MONGO_ROOT_32_CHARS
MONGO_USER=red_user
MONGO_PASSWORD=CHANGE_ME_STRONG_MONGO_32_CHARS
MONGO_DB=red_sovereign

# Redis - Cache & PubSub
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_32_CHARS

# ==================== STORAGE ====================
MINIO_USER=redadmin
MINIO_PASSWORD=CHANGE_ME_STRONG_MINIO_32_CHARS
MINIO_ROOT_USER=${MINIO_USER}
MINIO_ROOT_PASSWORD=${MINIO_PASSWORD}

# ==================== PSTN / ASTERISK ====================
AMI_USER=red_admin
AMI_PASSWORD=CHANGE_ME_STRONG_AMI_32_CHARS

# DINSTAR UC2000-VE-8T Hardware Gateway
DINSTAR_IP=192.168.1.100
DINSTAR_PORT=80
DINSTAR_AUTH_TOKEN=CHANGE_ME_DINSTAR_API_TOKEN

# ==================== TURN / STUN ====================
TURN_SECRET=CHANGE_ME_TURN_SECRET_48_CHARS_MINIMUM_SECURE
TURN_REALM=red.sovereign
SFU_ANNOUNCED_IP=

# ==================== SECURITY ====================
JWT_SECRET=CHANGE_ME_JWT_SECRET_64_CHARS_MIN_HS512_SECURE_RANDOM_KEY
JWT_EXPIRATION_MS=86400000

# ==================== MONITORING ====================
GRAFANA_USER=redadmin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_32_CHARS

# ==================== ANDROID APP BUILDCONFIG ====================
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
SIGNAL_URL=https://chat.red.local
STORAGE_URL=https://storage.red.local
SIGNAL_CDN_URL=https://cdn.red.local
SIGNAL_CDN2_URL=https://cdn2.red.local
SIGNAL_SFU_URL=https://sfu.red.local
SIGNAL_STORAGE_URL=https://storage.red.local
GIPHY_API_KEY=

# ==================== ADVANCED ====================
# Feature Flags
ENABLE_PSTN=true
ENABLE_VOIP_4K=true
ENABLE_STORIES=true
ENABLE_GROUPS=true
ENABLE_QUANTUM_GUARD=true

# Performance
JAVA_OPTS=-Xms512m -Xmx2g
POSTGRES_MAX_CONNECTIONS=200
REDIS_MAXMEMORY=512mb
