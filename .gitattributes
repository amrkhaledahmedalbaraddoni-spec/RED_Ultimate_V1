# Runtime scripts and Unix service configuration must remain LF on Windows checkouts.
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Native Windows runner remains CRLF-friendly.
*.ps1 text eol=crlf

# Binary artifacts.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
