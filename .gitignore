# ============================================================================
# RED — three planes, one contract. Nothing generated or secret is committed.
# ============================================================================

# ── Secrets and private configuration ───────────────────────────────────────
platform/config/.env
platform/config/.env.*
!platform/config/.env.example
platform/secrets/*
!platform/secrets/.gitkeep
.env
.env.*
secrets/
*.pem
*.key
*.jks
*.keystore
# Public debug-only keystore required for reproducible local APK builds.
!services/android/signing/red-debug.p12

# ── Data plane runtime artifacts ───────────────────────────────────────────
data/runtime/*
!data/runtime/.gitkeep
*.dump
*.bson
*.archive

# ── Build outputs (all planes) ─────────────────────────────────────────────
.gradle/
build/
**/build/
dist/
**/dist/
node_modules/
**/node_modules/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.zip
local-artifacts/
local-tools/*
!local-tools/.gitignore

# ── Tooling caches ─────────────────────────────────────────────────────────
local-maven/*
!local-maven/.gitignore
wire-handler/build/
__pycache__/
*.pyc

# ── IDE / OS / logs ────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.log
logs/
Thumbs.db
.DS_Store
