# RED Sovereign Unified - Environment Template
# انسخ إلى .env واستبدل كل قيمة قبل تشغيل Docker Compose
# Unified from: GitHub main + Sovereign (strict) + Ultimate V2 (monitoring/advanced)
# 100% Local Sovereign - Zero Cloud

# ==================== REQUIRED SECRETS (sovereign - must be long random) ====================
# كل هذه مطلوبة بعلامة :? في docker-compose - لن يبدأ بدونها
DB_PASSWORD=replace_with_a_long_random_database_password_32_chars_min
MONGO_PASSWORD=replace_with_a_long_random_mongodb_password_32_chars_min
MINIO_PASSWORD=replace_with_a_long_random_minio_password_32_chars_min
REDIS_PASSWORD=replace_with_a_long_random_redis_password_32_chars_min
AMI_PASSWORD=replace_with_a_long_random_asterisk_password_32_chars_min
TURN_SECRET=replace_with_a_long_random_turn_secret_32_chars_min
JWT_SECRET=replace_with_at_least_32_random_characters_JWT_HS256_SECURE

# Initial local administrator - يُنشأ فقط إذا لم يوجد حساب بهذا الاسم
RED_ADMIN_USERNAME=red_admin
RED_ADMIN_PASSWORD=replace_with_at_least_14_random_characters_admin

# DINSTAR local gateway credentials - لا تترك admin/admin أبدًا
DINSTAR_USERNAME=admin
DINSTAR_PASSWORD=replace_with_the_gateway_password_secure
DINSTAR_IP=192.168.11.1
DINSTAR_PORT=80
DINSTAR_SCHEME=http
# Ultimate extended (optional API token if gateway supports it)
DINSTAR_AUTH_TOKEN=

# ==================== NETWORK / ORIGINS ====================
TURN_PUBLIC_HOST=192.168.1.50
MEDIASOUP_ANNOUNCED_IP=192.168.1.50
MEDIASOUP_WORKERS=2
RED_HTTP_PORT=80
# Ultimate also supports 8088 for LAN dev; unified defaults to 80 (nginx) but allow override
ALLOWED_ORIGINS=http://localhost:80,http://127.0.0.1:80,http://192.168.1.50:80
REFRESH_EXPIRATION_DAYS=30
RED_DEVICE_CERTIFICATE_VALID_DAYS=90

# ==================== DATABASE TUNING (from Ultimate, optional) ====================
POSTGRES_DB=red_sovereign
POSTGRES_USER=admin
MONGO_DB=red_sovereign
MONGO_ROOT_USER=red_root
MONGO_ROOT_PASSWORD=${MONGO_PASSWORD}
MINIO_USER=redadmin
AMI_USER=red_admin

# ==================== MONITORING (from Ultimate V2) ====================
GRAFANA_USER=redadmin
GRAFANA_PASSWORD=replace_with_grafana_secure_32_chars_min
GRAFANA_PASS=${GRAFANA_PASSWORD}

# ==================== ADVANCED / FEATURE FLAGS (from Ultimate) ====================
ENABLE_PSTN=true
ENABLE_VOIP_4K=true
ENABLE_STORIES=true
ENABLE_GROUPS=true
ENABLE_QUANTUM_GUARD=true
JAVA_OPTS=-Xms512m -Xmx2g
POSTGRES_MAX_CONNECTIONS=200
REDIS_MAXMEMORY=512mb
SFU_ANNOUNCED_IP=${MEDIASOUP_ANNOUNCED_IP}

# ==================== ANDROID BUILDCONFIG (optional, for red-app) ====================
# Maps / CDN - leave empty for pure local
MAPS_API_KEY=
SIGNAL_URL=http://localhost:8080
STORAGE_URL=http://localhost:9000
SIGNAL_CDN_URL=http://localhost:9000
SIGNAL_CDN2_URL=http://localhost:9000
SIGNAL_SFU_URL=ws://localhost:4000
SIGNAL_STORAGE_URL=http://localhost:9000
GIPHY_API_KEY=
