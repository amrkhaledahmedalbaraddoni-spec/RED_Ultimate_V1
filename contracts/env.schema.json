{
  "$schema": "https://red.local/schemas/env.schema.json",
  "version": 1,
  "description": "Single source of truth for every runtime variable. platform/config/.env.example is generated from this file by tools/env/render_env.py and validated by tools/guard/separation_guard.py. No service may invent an environment variable outside this contract.",
  "planes": {
    "runtime": "Used to wire the stack in platform/compose/docker-compose.yml",
    "backend": "Consumed by services/backend",
    "android": "Baked into the APK at build time (Gradle property, not runtime env)",
    "data": "Consumed by stateful engines (PostgreSQL/MongoDB/Redis/MinIO) at startup"
  },
  "variables": [
    {
      "name": "POSTGRES_DB",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "red_sovereign"
    },
    {
      "name": "POSTGRES_USER",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "admin"
    },
    {
      "name": "POSTGRES_MAX_CONNECTIONS",
      "plane": "runtime",
      "required": false,
      "secret": false,
      "default": "200"
    },
    {
      "name": "DB_PASSWORD",
      "plane": "backend",
      "required": true,
      "secret": true,
      "default": null,
      "min_length": 32
    },
    {
      "name": "MONGO_DB",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "red_sovereign"
    },
    {
      "name": "MONGO_ROOT_USER",
      "plane": "runtime",
      "required": false,
      "secret": false,
      "default": "red_root"
    },
    {
      "name": "MONGO_USER",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "red_user"
    },
    {
      "name": "MONGO_PASSWORD",
      "plane": "backend",
      "required": true,
      "secret": true,
      "default": null,
      "min_length": 32
    },
    {
      "name": "MONGO_ROOT_PASSWORD",
      "plane": "data",
      "required": true,
      "secret": true,
      "default": null,
      "min_length": 32
    },
    {
      "name": "REDIS_PASSWORD",
      "plane": "backend",
      "required": true,
      "secret": true,
      "default": null,
      "min_length": 32
    },
    {
      "name": "REDIS_MAXMEMORY",
      "plane": "runtime",
      "required": false,
      "secret": false,
      "default": "512mb"
    },
    {
      "name": "MINIO_USER",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "redadmin"
    },
    {
      "name": "MINIO_PASSWORD",
      "plane": "backend",
      "required": true,
      "secret": true,
      "default": null,
      "min_length": 32
    },
    {
      "name": "JWT_SECRET",
      "plane": "backend",
      "required": true,
      "secret": true,
      "default": null,
      "min_length": 48
    },
    {
      "name": "RED_ADMIN_USERNAME",
      "plane": "backend",
      "required": true,
      "secret": false,
      "default": "red_admin"
    },
    {
      "name": "RED_ADMIN_PASSWORD",
      "plane": "backend",
      "required": true,
      "secret": true,
      "default": null,
      "min_length": 20
    },
    {
      "name": "REFRESH_EXPIRATION_DAYS",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "30"
    },
    {
      "name": "RED_DEVICE_CERTIFICATE_VALID_DAYS",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "90"
    },
    {
      "name": "AMI_USER",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "red_admin"
    },
    {
      "name": "AMI_PASSWORD",
      "plane": "backend",
      "required": true,
      "secret": true,
      "default": null,
      "min_length": 32
    },
    {
      "name": "DINSTAR_USERNAME",
      "plane": "backend",
      "required": true,
      "secret": false,
      "default": "admin"
    },
    {
      "name": "DINSTAR_PASSWORD",
      "plane": "backend",
      "required": true,
      "secret": true,
      "default": null,
      "min_length": 20
    },
    {
      "name": "DINSTAR_IP",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "192.168.11.1"
    },
    {
      "name": "DINSTAR_PORT",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "80"
    },
    {
      "name": "DINSTAR_SCHEME",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "http"
    },
    {
      "name": "TURN_SECRET",
      "plane": "backend",
      "required": true,
      "secret": true,
      "default": null,
      "min_length": 32
    },
    {
      "name": "TURN_PUBLIC_HOST",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "192.168.1.50"
    },
    {
      "name": "MEDIASOUP_ANNOUNCED_IP",
      "plane": "runtime",
      "required": true,
      "secret": false,
      "default": null
    },
    {
      "name": "MEDIASOUP_WORKERS",
      "plane": "runtime",
      "required": false,
      "secret": false,
      "default": "2"
    },
    {
      "name": "SFU_LOG_LEVEL",
      "plane": "runtime",
      "required": false,
      "secret": false,
      "default": "warn"
    },
    {
      "name": "ALLOWED_ORIGINS",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "http://localhost,http://127.0.0.1"
    },
    {
      "name": "RED_HTTP_PORT",
      "plane": "runtime",
      "required": false,
      "secret": false,
      "default": "80"
    },
    {
      "name": "JAVA_OPTS",
      "plane": "backend",
      "required": false,
      "secret": false,
      "default": "-Xms512m -Xmx2g -XX:+UseG1GC"
    },
    {
      "name": "GRAFANA_USER",
      "plane": "runtime",
      "required": false,
      "secret": false,
      "default": "redadmin"
    },
    {
      "name": "GRAFANA_PASSWORD",
      "plane": "runtime",
      "required": true,
      "secret": true,
      "default": null,
      "min_length": 32
    },
    {
      "name": "GRAFANA_ROOT_URL",
      "plane": "runtime",
      "required": false,
      "secret": false,
      "default": "http://localhost/grafana/"
    },
    {
      "name": "PROMETHEUS_RETENTION",
      "plane": "runtime",
      "required": false,
      "secret": false,
      "default": "200h"
    }
  ],
  "android_build": {
    "description": "Android reads server wiring at build time through Gradle properties, never through runtime env.",
    "properties": [
      {
        "name": "RED_SERVER_URL",
        "default": "http://192.168.1.50:80"
      },
      {
        "name": "RED_TARGET_ABI",
        "default": "arm64-v8a"
      }
    ]
  }
}
