{
  "$schema": "https://red.local/schemas/stack.schema.json",
  "version": 1,
  "description": "Canonical description of the runtime stack. platform/compose/docker-compose.yml must match this contract service-for-service; tools/guard/separation_guard.py fails otherwise. Nothing here contains application code or data.",
  "network": {
    "name": "red-net",
    "subnet": "172.28.0.0/16"
  },
  "entrypoint": {
    "gateway": "nginx",
    "published": "${RED_HTTP_PORT:-80}"
  },
  "planes": {
    "application": "Long-running RED services built from services/",
    "telephony": "PSTN bridge configuration, voice only",
    "data": "Stateful engines; schema and seed ownership is declared in data.json",
    "edge": "Routing, TLS termination and observability"
  },
  "services": [
    {
      "name": "backend",
      "plane": "application",
      "purpose": "HTTP API, /ws/master messaging, /ws/calls signalling, approval and media grants",
      "owner": "services/backend",
      "container": "red-backend",
      "build": {
        "context": "../..",
        "dockerfile": "platform/containers/backend.Dockerfile"
      },
      "ports": [
        "127.0.0.1:8080:8080"
      ],
      "health": {
        "type": "http",
        "port": 8080,
        "path": "/health"
      },
      "binds": [
        "../secrets:/run/secrets:ro"
      ],
      "volumes": [
        "backend-logs"
      ],
      "depends_on": [
        "db-postgres",
        "db-mongo",
        "cache-redis",
        "minio"
      ]
    },
    {
      "name": "media-sfu",
      "plane": "application",
      "purpose": "WebRTC SFU for RED voice/video (no SIP)",
      "owner": "services/media-sfu",
      "container": "red-media-sfu",
      "build": {
        "context": "../..",
        "dockerfile": "platform/containers/sfu.Dockerfile"
      },
      "ports": [
        "127.0.0.1:4000:4000",
        "40000-40100:40000-40100/udp",
        "40000-40100:40000-40100/tcp"
      ],
      "health": {
        "type": "http",
        "port": 4000,
        "path": "/health"
      },
      "binds": [],
      "volumes": [
        "sfu-logs"
      ],
      "depends_on": [
        "backend"
      ]
    },
    {
      "name": "admin-panel",
      "plane": "application",
      "purpose": "Static admin SPA; routing is owned by the edge gateway",
      "owner": "services/admin-dashboard",
      "container": "red-admin-ui",
      "build": {
        "context": "../..",
        "dockerfile": "platform/containers/admin.Dockerfile"
      },
      "ports": [],
      "health": {
        "type": "http",
        "port": 3000,
        "path": "/healthz"
      },
      "binds": [],
      "volumes": [],
      "depends_on": []
    },
    {
      "name": "pstn-gateway",
      "plane": "telephony",
      "purpose": "Asterisk bridge to DINSTAR UC2000-VE-8T; voice only, no WebRTC client",
      "owner": "platform/telephony",
      "container": "red-pstn-gateway",
      "build": {
        "context": "../telephony",
        "dockerfile": "../containers/pstn.Dockerfile"
      },
      "ports": [
        "5060:5060/udp",
        "5060:5060/tcp",
        "10000-10100:10000-10100/udp"
      ],
      "health": {
        "type": "command",
        "detail": "asterisk -rx 'core show version'"
      },
      "binds": [
        "../telephony:/etc/asterisk:ro"
      ],
      "volumes": [
        "asterisk-logs",
        "asterisk-spool"
      ],
      "depends_on": [
        "backend"
      ],
      "not_published": [
        "5038/tcp (AMI)"
      ]
    },
    {
      "name": "coturn",
      "plane": "edge",
      "purpose": "STUN/TURN NAT traversal for RED WebRTC",
      "owner": "platform/compose",
      "container": "red-turn",
      "build": null,
      "image": "coturn/coturn:4.6.2-alpine",
      "ports": [
        "3478:3478",
        "3478:3478/udp",
        "45000-45050:45000-45050/udp"
      ],
      "health": {
        "type": "none"
      },
      "binds": [],
      "volumes": [
        "turn-data"
      ],
      "depends_on": []
    },
    {
      "name": "db-postgres",
      "plane": "data",
      "purpose": "Identities, approval, refresh sessions, audit, public pre-keys",
      "owner": "data",
      "container": "red-db-sql",
      "build": null,
      "image": "postgres:16-alpine",
      "ports": [
        "127.0.0.1:5432:5432"
      ],
      "health": {
        "type": "command",
        "detail": "pg_isready"
      },
      "binds": [],
      "volumes": [
        "postgres-data"
      ],
      "depends_on": [],
      "schema": "data/sql/migrations (Flyway, owned by the backend process at startup)"
    },
    {
      "name": "db-mongo",
      "plane": "data",
      "purpose": "Ciphertext messages, sequences, social graph, stories, call log",
      "owner": "data",
      "container": "red-db-nosql",
      "build": null,
      "image": "mongo:8.0",
      "ports": [
        "127.0.0.1:27017:27017"
      ],
      "health": {
        "type": "command",
        "detail": "db.adminCommand('ping')"
      },
      "binds": [
        "../../data/mongo/init.js:/docker-entrypoint-initdb.d/mongo-init.js:ro"
      ],
      "volumes": [
        "mongo-data",
        "mongo-config"
      ],
      "depends_on": [],
      "schema": "data/mongo/init.js (first-init indexes and TTLs)"
    },
    {
      "name": "cache-redis",
      "plane": "data",
      "purpose": "Rate limits, PSTN daily counters, short-lived state",
      "owner": "data",
      "container": "red-cache",
      "build": null,
      "image": "redis:7-alpine",
      "ports": [
        "127.0.0.1:6379:6379"
      ],
      "health": {
        "type": "command",
        "detail": "redis-cli ping"
      },
      "binds": [],
      "volumes": [
        "redis-data"
      ],
      "depends_on": []
    },
    {
      "name": "minio",
      "plane": "data",
      "purpose": "Local S3-compatible object storage for media and backups",
      "owner": "data",
      "container": "red-storage",
      "build": null,
      "image": "minio/minio:RELEASE.2024-12-18T13-15-44Z",
      "ports": [
        "9000:9000",
        "127.0.0.1:9001:9001"
      ],
      "health": {
        "type": "http",
        "port": 9000,
        "path": "/minio/health/live"
      },
      "binds": [],
      "volumes": [
        "minio-data"
      ],
      "depends_on": []
    },
    {
      "name": "minio-setup",
      "plane": "data",
      "purpose": "One-shot private bucket bootstrap (no anonymous access)",
      "owner": "data",
      "container": "red-minio-setup",
      "build": null,
      "image": "minio/mc:latest",
      "ports": [],
      "health": {
        "type": "none"
      },
      "binds": [],
      "volumes": [],
      "depends_on": [
        "minio"
      ]
    },
    {
      "name": "nginx",
      "plane": "edge",
      "purpose": "Single HTTP entry: /api, /ws, /sfu, /minio, admin SPA, monitoring",
      "owner": "platform/proxy",
      "container": "red-proxy",
      "build": null,
      "image": "nginx:1.27-alpine",
      "ports": [
        "${RED_HTTP_PORT:-80}:80"
      ],
      "health": {
        "type": "command",
        "detail": "nginx -t"
      },
      "binds": [
        "../proxy/nginx.conf:/etc/nginx/nginx.conf:ro",
        "../proxy/certs:/etc/nginx/certs:ro"
      ],
      "volumes": [
        "nginx-logs"
      ],
      "depends_on": [
        "backend",
        "admin-panel",
        "media-sfu"
      ]
    },
    {
      "name": "prometheus",
      "plane": "edge",
      "purpose": "Metrics collection",
      "owner": "platform/monitoring",
      "container": "red-prometheus",
      "build": null,
      "image": "prom/prometheus:v3.0.1",
      "ports": [
        "127.0.0.1:9090:9090"
      ],
      "health": {
        "type": "http",
        "port": 9090,
        "path": "/-/healthy"
      },
      "binds": [
        "../monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro"
      ],
      "volumes": [
        "prometheus-data"
      ],
      "depends_on": []
    },
    {
      "name": "grafana",
      "plane": "edge",
      "purpose": "Dashboards over Prometheus",
      "owner": "platform/monitoring",
      "container": "red-grafana",
      "build": null,
      "image": "grafana/grafana:11.4.0",
      "ports": [
        "127.0.0.1:3001:3000"
      ],
      "health": {
        "type": "http",
        "port": 3000,
        "path": "/api/health"
      },
      "binds": [
        "../monitoring/grafana/datasources.yml:/etc/grafana/provisioning/datasources/datasources.yml:ro",
        "../monitoring/grafana/dashboards.yml:/etc/grafana/provisioning/dashboards/dashboards.yml:ro"
      ],
      "volumes": [
        "grafana-data"
      ],
      "depends_on": [
        "prometheus"
      ]
    }
  ],
  "volumes": [
    "postgres-data",
    "mongo-data",
    "mongo-config",
    "redis-data",
    "minio-data",
    "backend-logs",
    "sfu-logs",
    "asterisk-logs",
    "asterisk-spool",
    "nginx-logs",
    "turn-data",
    "prometheus-data",
    "grafana-data"
  ],
  "extra_builds": [
    {
      "name": "verification-image",
      "context": ".",
      "dockerfile": "platform/containers/ci.Dockerfile",
      "purpose": "Builds and tests every plane (backend, Android, admin, SFU, PSTN config, guard)."
    }
  ]
}
