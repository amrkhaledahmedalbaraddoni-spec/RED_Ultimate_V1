# ── RUNTIME TOPOLOGY — ports, workers, retention ──
POSTGRES_MAX_CONNECTIONS=200
MONGO_ROOT_USER=red_root
REDIS_MAXMEMORY=512mb
MEDIASOUP_ANNOUNCED_IP=CHANGE_ME_MEDIASOUP_ANNOUNCED_IP
MEDIASOUP_WORKERS=2
SFU_LOG_LEVEL=warn
RED_HTTP_PORT=80
GRAFANA_USER=redadmin
GRAFANA_ROOT_URL=http://localhost/grafana/
PROMETHEUS_RETENTION=200h

# ── SERVICE WIRING — consumed by services/backend ──
POSTGRES_DB=red_sovereign
POSTGRES_USER=admin
MONGO_DB=red_sovereign
MONGO_USER=red_user
MINIO_USER=redadmin
RED_ADMIN_USERNAME=red_admin
REFRESH_EXPIRATION_DAYS=30
RED_DEVICE_CERTIFICATE_VALID_DAYS=90
AMI_USER=red_admin
DINSTAR_USERNAME=admin
DINSTAR_IP=192.168.11.1
DINSTAR_PORT=80
DINSTAR_SCHEME=http
TURN_PUBLIC_HOST=192.168.1.50
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
JAVA_OPTS=-Xms512m -Xmx2g -XX:+UseG1GC

