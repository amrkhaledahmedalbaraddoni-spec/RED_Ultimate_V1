MONGO_PASSWORD=CHANGE_ME_MONGO_PASSWORD
# secret - minimum 32 characters, generated on first run
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT_PASSWORD
# secret - minimum 32 characters, generated on first run
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# secret - minimum 32 characters, generated on first run
MINIO_PASSWORD=CHANGE_ME_MINIO_PASSWORD
# secret - minimum 48 characters, generated on first run
JWT_SECRET=CHANGE_ME_JWT_SECRET
# secret - minimum 20 characters, generated on first run
RED_ADMIN_PASSWORD=CHANGE_ME_RED_ADMIN_PASSWORD
# secret - minimum 32 characters, generated on first run
AMI_PASSWORD=CHANGE_ME_AMI_PASSWORD
# secret - minimum 20 characters, generated on first run
DINSTAR_PASSWORD=CHANGE_ME_DINSTAR_PASSWORD
# secret - minimum 32 characters, generated on first run
TURN_SECRET=CHANGE_ME_TURN_SECRET
